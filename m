-	/* find the port in the chain */
-
-	info =3D ports;
-
-	while (info && (info->line !=3D line))
-		info =3D info->next_port;
-
-	if (!info) {
-		serial_paranoia_check(info, tty->name, "esp_open");
-		return -ENODEV;
